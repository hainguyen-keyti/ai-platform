# Copy to .env and replace the three secrets below before running; every other
# value is the one a real run uses.

# Signs user JWTs. Any long random string. Set on the api.
JWT_SECRET=change-me-to-a-long-random-string

# How many hours a login lasts before the user signs in again. Set on the api.
TOKEN_TTL_HOURS=24

# Required to register. Share it with teammates, rotate to close signups. Set on
# the api.
INVITE_CODE=change-me

# Shared secret the worker uses on /internal endpoints. Not a user credential.
WORKER_TOKEN=change-me-too

# The worker's lines (API_URL, PROVIDER_MODE, PROVIDERS and the pacing) are read
# by scripts/run-worker.sh, which exports every line of this file to the worker.
# A name given on the command line, or already exported by the shell that starts
# it, wins over the file, even an empty one: `PROVIDER_MODE=mock PROVIDERS=grok
# ./scripts/run-worker.sh` runs a mock grok worker whatever this file says.

# Where the worker finds the API. The worker runs on the host, the API in Docker.
API_URL=http://localhost:3000

# Worker provider mode: real drives cloakbrowser, mock returns canned results.
PROVIDER_MODE=real

# Which providers this worker serves, comma separated. Each one gets its own
# runner thread and its own browser, because two stealth browsers cannot be
# launched from a single thread, and its own pacing, so a provider sitting out a
# cooldown never parks the others. Each needs its own saved session:
# `python scripts/login_provider.py <name>`.
PROVIDERS=chatgpt,grok,gemini

# A job whose provider no worker has asked for within this window is failed as
# no_worker and refunded, rather than waiting for a worker that is not coming.
# Set on the api. Keep it well above the pacing gap: a worker pausing between
# turns says it is alive, but a restart takes a moment.
# The api never applies less than int(JOB_LEASE_SECONDS / 3) * 2 + 30 (twice
# the longest heartbeat gap it allows, a third of the lease, then 30s for a
# restart), which is 310 with the lease below.
NO_WORKER_SECONDS=310

# A turn refused because the provider's account needs its admin (signed out,
# memory on) holds that provider out this long: not offered, no new turn taken,
# waiting jobs refunded. Then the next turn finds out whether it has been fixed.
# Set on the api.
PROVIDER_HOLD_SECONDS=600
# The worker: when it cleans ChatGPT's Library each day, HH:MM in UTC (16:30 is 23:30 in Vietnam). It
# moves to the Library's trash the pictures from before today of the platform's own threads, and
# nothing else on the account. Empty turns it off.
LIBRARY_CLEANUP_AT=16:30

# Pacing for the shared account. Heavy use slowed replies from 12s to 256s and
# produced error banners, so the worker waits between turns, caps images per
# rolling 3 hours (Plus allows roughly 50), and backs off after provider errors.
MIN_GAP_SECONDS=3
IMAGE_BUDGET_3H=40
COOLDOWN_BASE_SECONDS=30
COOLDOWN_MAX_SECONDS=900

# Any of those four can be set per provider by adding the provider's name, for
# accounts with very different rhythms. Measured 2026-09-24: a free grok account
# answers a short burst and then asks for about nine minutes.
MIN_GAP_SECONDS__GROK=150
COOLDOWN_BASE_SECONDS__GROK=600

# Job leases, set on the api. A worker renews every third of the lease, and at
# least every 5s so a Stop reaches it while the turn still runs; a worker that
# dies stops renewing and the job is handed out again, up to the cap.
JOB_LEASE_SECONDS=420
JOB_MAX_ATTEMPTS=3

# Each user's balance comes back up to their daily cap (DEFAULT_QUOTA at signup,
# adjustable per user by an admin) on the first request of each UTC day.
# CLOCK_OFFSET_SECONDS is a test seam that moves "today"; leave it at 0. Both
# set on the api.
DEFAULT_QUOTA=500
CLOCK_OFFSET_SECONDS=0

# DB_PATH and MEDIA_PATH are deliberately absent: those are container paths and
# docker-compose.yml sets them. Putting them here would make the host worker,
# which sources this file, try to write to a directory that exists only in the
# API container. Every setting marked "set on the api" reaches the container
# because docker-compose.yml names it under the api service.
